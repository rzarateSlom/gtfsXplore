# Base del servicio GtfsExposeAPI, sin barra final.
# En dev, dejalo en /gtfs para usar el proxy de vite.config.ts y evitar CORS.
VITE_API_BASE=/gtfs/GtfsExposeAPI

# Producción (backend con CORS habilitado en /rest/*):
# VITE_API_BASE=https://sandbox10.gxapps.cloud/Idfe29b64088e003f406278efeca1a363c/GtfsExposeAPI

# Opcional: fija el feed a usar sin pasar por /ActiveFeedVersion (útil para fijar
# una versión específica). Si se deja vacío, el cliente resuelve el feed activo solo.
VITE_API_GUID=
